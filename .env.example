CONTENT_OS_DATA=
# Optional path to an authorized legacy Content OS tree. Never commit that tree.
CONTENT_OS_LEGACY_ROOT=
DEEPSEEK_BASE_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
DOUBAO_BASE_URL=
DOUBAO_API_KEY=
DOUBAO_MODEL=
GLM_BASE_URL=
GLM_API_KEY=
GLM_MODEL=
MINIMAX_BASE_URL=
MINIMAX_API_KEY=
MINIMAX_MODEL=

# Optional existing local Jianying drafts folder; new export folders only
JIANYING_DRAFT_ROOT=

# Optional existing LOCAL embedding model directory. Never downloaded by this app.
CONTENT_OS_LOCAL_EMBEDDING_MODEL=
# Optional installed Chrome/Chromium render browser
REMOTION_BROWSER_EXECUTABLE=

# Optional LOCAL TTS adapter: JSON argv, never a shell command.
# Example: ["/absolute/path/python3", "/absolute/path/local_tts_bridge.py"]
CONTENT_OS_LOCAL_TTS_COMMAND=
# Optional custom CLOUD TTS JSON bridge; not a pre-verified vendor adapter.
CONTENT_OS_CLOUD_TTS_URL=
CONTENT_OS_CLOUD_TTS_KEY=
