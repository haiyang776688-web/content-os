{
  "$defs": {
    "FontRole": {
      "additionalProperties": false,
      "properties": {
        "font_id": {
          "title": "Font Id",
          "type": "string"
        },
        "weight": {
          "default": 400,
          "maximum": 1000,
          "minimum": 1,
          "title": "Weight",
          "type": "integer"
        },
        "size": {
          "default": 48,
          "exclusiveMinimum": 0,
          "title": "Size",
          "type": "number"
        },
        "letter_spacing": {
          "default": 0,
          "title": "Letter Spacing",
          "type": "number"
        },
        "line_height": {
          "default": 1.15,
          "exclusiveMinimum": 0,
          "title": "Line Height",
          "type": "number"
        },
        "shadow": {
          "default": "0 2px 4px #0008",
          "title": "Shadow",
          "type": "string"
        }
      },
      "required": [
        "font_id"
      ],
      "title": "FontRole",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "profile_id": {
      "title": "Profile Id",
      "type": "string"
    },
    "version": {
      "default": "1",
      "title": "Version",
      "type": "string"
    },
    "roles": {
      "additionalProperties": {
        "$ref": "#/$defs/FontRole"
      },
      "title": "Roles",
      "type": "object"
    },
    "production_policy": {
      "default": "STRICT_FONT",
      "enum": [
        "STRICT_FONT",
        "ALLOW_FALLBACK"
      ],
      "title": "Production Policy",
      "type": "string"
    },
    "fallback_font_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fallback Font Id"
    }
  },
  "required": [
    "profile_id",
    "roles"
  ],
  "title": "TypographyProfile",
  "type": "object"
}
