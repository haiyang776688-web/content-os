{
  "source": {
    "script_id": "VLA-001-UNSEEN-SCRIPT",
    "script_sha256": "f1bf64bc72222c2aa93878bdc71c635b5897db471108f07925fe1c82ea57139f",
    "segments": [
      {
        "segment_id": "B-SEG01",
        "text": "做视频最贵的返工，往往不是渲染慢，而是到成片才发现镜头职责错了。",
        "fact_ids": []
      },
      {
        "segment_id": "B-SEG02",
        "text": "比如这张分镜接触表，画面能看，但你只能看到结果。",
        "fact_ids": [
          "B-F01"
        ]
      },
      {
        "segment_id": "B-SEG03",
        "text": "它没有直接告诉你：这一镜为什么用证据，下一镜为什么让 XIAO-Y 出现。",
        "fact_ids": [
          "B-F01"
        ]
      },
      {
        "segment_id": "B-SEG04",
        "text": "真正可审查的分镜，要把视觉任务、主角和证据处理一起摆出来。",
        "fact_ids": [
          "B-F02"
        ]
      },
      {
        "segment_id": "B-SEG05",
        "text": "当口播在证明或演示，界面截图和关键区域应该占据画面主位。",
        "fact_ids": [
          "B-F02"
        ]
      },
      {
        "segment_id": "B-SEG06",
        "text": "角色这时只负责指引，不能挡住真正需要看的证据。",
        "fact_ids": [
          "B-F02"
        ]
      },
      {
        "segment_id": "B-SEG07",
        "text": "到了警告、转场和总结，XIAO-Y 才回来，负责提醒、承接和收束。",
        "fact_ids": []
      },
      {
        "segment_id": "B-SEG08",
        "text": "更关键的是，人工必须能在渲染前修改或拒绝这份镜头计划。",
        "fact_ids": [
          "B-F02"
        ]
      },
      {
        "segment_id": "B-SEG09",
        "text": "先看懂，再批准，最后才渲染，才能把昂贵的错误挡在前面。",
        "fact_ids": []
      }
    ],
